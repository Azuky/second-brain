{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "timeout": 10,
            "statusMessage": "Method: loading rules"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" metrics-event session-start",
            "timeout": 10,
            "statusMessage": "Method: recording session start"
          }
        ],
        "matcher": "startup|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" check-close stop",
            "timeout": 10,
            "statusMessage": "Method: checking session close"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" metrics-event stop",
            "timeout": 10,
            "statusMessage": "Method: recording session stop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" check-close precompact",
            "timeout": 10,
            "statusMessage": "Method: checking state before compacting"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" check-brief",
            "timeout": 10,
            "statusMessage": "Method: checking subagent report"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" metrics-event subagent-stop",
            "timeout": 10,
            "statusMessage": "Method: recording subagent stop"
          }
        ]
      }
    ]
  }
}
